/* Default vivus-sidebar style. Copy to ~/.config/vivus/sidebar.qss to customize.
   Selectors: #VivusSidebar, #StateDot, #StateLabel, #History, #Document,
   #Transcript, #Input, #TalkButton, #SettingsButton, #QuitButton.
   Settings window: #VivusSettings, #InputDevice, #InputLevel (`clipped`
   property), #InputGain, #EndOfTurnSilence, #OutputDevice, #SpeechVolume,
   #DuckVolume, #SettingsStatus, #OpenConfigButton.
   #VivusSidebar and #StateDot carry a `state` property:
   idle | listening | thinking | speaking | disconnected. */

#VivusSidebar {
    background: palette(window);
}

#StateDot {
    border-radius: 5px;
    background: palette(mid);
}
#StateDot[state="disconnected"] { background: #808080; }
#StateDot[state="listening"]    { background: #e05050; }
#StateDot[state="thinking"]     { background: #e0b030; }
#StateDot[state="speaking"]     { background: #40b060; }

#StateLabel {
    color: palette(placeholder-text);
}

#Document {
    background: palette(base);
    border-radius: 8px;
    padding: 8px;
}

/* Live transcript of what you're saying; `is-final` is false while recognizing. */
#Transcript {
    padding: 4px 2px;
}
#Transcript[is-final="false"] {
    color: palette(placeholder-text);
    font-style: italic;
}

#Input {
    padding: 6px 8px;
    border-radius: 6px;
    border: 1px solid palette(mid);
    background: palette(base);
}
#Input:focus {
    border-color: palette(highlight);
}

#QuitButton, #SettingsButton {
    padding: 4px 10px;
}

#TalkButton {
    padding: 6px 14px;
}

#VivusSettings {
    background: palette(window);
}

#InputLevel {
    min-height: 10px;
    max-height: 10px;
    border-radius: 5px;
    background: palette(base);
    border: 1px solid palette(mid);
}
#InputLevel::chunk {
    border-radius: 4px;
    background: #40b060;
}
#InputLevel[clipped="true"] {
    border-color: #e05050;
}
#InputLevel[clipped="true"]::chunk {
    background: #e05050;
}

#SettingsStatus {
    color: #e05050;
}
