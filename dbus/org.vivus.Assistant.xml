<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Service: org.vivus (session bus), object: /org/vivus
  Shared by vivus-daemon (server), vivusctl, vivus-sidebar and the Forest bridge.
  Keep crates/dbus/src/lib.rs in sync with this file.
-->
<node>
  <interface name="org.vivus.Assistant">
    <!-- idle | listening | thinking | speaking. Changes via org.freedesktop.DBus.Properties.PropertiesChanged. -->
    <property name="State" type="s" access="read"/>

    <method name="ToggleListen"/>
    <!-- Push-to-talk. -->
    <method name="StartListening"/>
    <method name="StopListening"/>
    <!-- Text input, bypassing STT. -->
    <method name="Ask">
      <arg name="text" type="s" direction="in"/>
    </method>
    <!-- Interrupt: cancels in-flight TTS, LLM streams and tool calls. -->
    <method name="Cancel"/>
    <!-- Shuts the daemon down. The sidebar calls this before closing itself. -->
    <method name="Quit"/>

    <!-- role: user | assistant. Partial (is_final=false) user text updates live
         while speaking; each utterance ends with one is_final=true. -->
    <signal name="Transcript">
      <arg name="role" type="s"/>
      <arg name="text" type="s"/>
      <arg name="is_final" type="b"/>
    </signal>

    <!-- Asks UIs to show, hide or toggle the sidebar. -->
    <method name="ToggleSidebar"/>
    <signal name="SidebarVisibilityRequested">
      <!-- show | hide | toggle -->
      <arg name="action" type="s"/>
    </signal>
  </interface>

  <interface name="org.vivus.Documents">
    <!-- Ids, oldest first. -->
    <method name="List">
      <arg name="ids" type="as" direction="out"/>
    </method>
    <method name="Get">
      <arg name="id" type="s" direction="in"/>
      <arg name="title" type="s" direction="out"/>
      <arg name="markdown" type="s" direction="out"/>
    </method>
    <!-- Emitted on create and on every append/replace. -->
    <signal name="DocumentChanged">
      <arg name="id" type="s"/>
      <arg name="title" type="s"/>
      <arg name="markdown" type="s"/>
    </signal>
  </interface>

  <!-- Edits ~/.config/vivus/config.toml; the daemon validates, writes and applies.
       Paths are dotted keys, e.g. audio.input, roles.stt.model. -->
  <interface name="org.vivus.Settings">
    <!-- The effective config as JSON, defaults filled in (unset options are null). -->
    <method name="Get">
      <arg name="json" type="s" direction="out"/>
    </method>
    <!-- Sets one key. A dictionary (a{sv}) is written as a whole table, e.g.
         providers.<name> = {base_url} adds a provider. An
         invalid path or value fails with the reason and leaves the file alone. -->
    <method name="Set">
      <arg name="path" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <!-- Removes a key from the file, so its default applies. Removing
         providers.<name> also deletes its API key; refused while a role uses it. -->
    <method name="Reset">
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- After a write or a reload of a hand edit: the leaf paths whose effective value changed. -->
    <signal name="Changed">
      <arg name="paths" type="as"/>
    </signal>

    <!-- Audio sources and sinks for audio.input / audio.output: node name (the
         setting's value), description, is the system default, direction
         (source | sink). Our own echo-cancel nodes are left out. -->
    <method name="ListAudioDevices">
      <arg name="devices" type="a(ssbs)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="AudioDeviceList"/>
    </method>
    <!-- On hotplug or a default change, with the new list. -->
    <signal name="AudioDevicesChanged">
      <arg name="devices" type="a(ssbs)"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="AudioDeviceList"/>
    </signal>

    <!-- Providers that can serve a role (stt, tts, router, answer, agent,
         vision), as name (the roles.<role>.provider value) and label, e.g.
         "groq (no key)", "Claude Code (not installed)". The [providers] entries,
         then claude-code. Speech roles list none: unset means local speech. -->
    <method name="ListProviders">
      <arg name="role" type="s" direction="in"/>
      <arg name="providers" type="a(ss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="ChoiceList"/>
    </method>
    <!-- Models a provider offers for a role: id (the roles.<role>.model value)
         and label. An empty id is the unset model, i.e. the provider's default.
         An empty provider means local speech (stt and tts). Local speech lists
         the models on disk, [providers] entries their /models, claude-code its
         aliases. Fails with the reason
         if the provider can't be reached. -->
    <method name="ListModels">
      <arg name="role" type="s" direction="in"/>
      <arg name="provider" type="s" direction="in"/>
      <arg name="models" type="a(ss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="ChoiceList"/>
    </method>
    <!-- TTS voices of a model, as id and label; empty id is the model's default
         voice. Empty provider or model mean the defaults, as in ListModels. -->
    <method name="ListVoices">
      <arg name="provider" type="s" direction="in"/>
      <arg name="model" type="s" direction="in"/>
      <arg name="voices" type="a(ss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="ChoiceList"/>
    </method>

    <!-- Stores a provider's API key in the keyring (Secret Service), or in
         ~/.config/vivus/.env (0600) without one; an empty key removes it.
         Keys are never sent back out. The router and the provider's model list
         are rebuilt with the new key. -->
    <method name="SetApiKey">
      <arg name="provider" type="s" direction="in"/>
      <arg name="key" type="s" direction="in"/>
    </method>
    <!-- Where a provider's key comes from: environment (its variable is set,
         which wins over a stored key), keyring, file (.env) or missing. -->
    <method name="ApiKeyStatus">
      <arg name="provider" type="s" direction="in"/>
      <arg name="status" type="s" direction="out"/>
    </method>

    <!-- Sends InputLevel for the next 5 s, keeping the mic open meanwhile;
         call again to extend (a settings page calls it every couple of seconds). -->
    <method name="MeterInput"/>
    <!-- About 20 times a second while metering: the peak of what STT hears
         (after echo cancellation), 0 to 1 linear, and whether it hit full scale. -->
    <signal name="InputLevel">
      <arg name="peak" type="d"/>
      <arg name="clipped" type="b"/>
    </signal>

    <!-- The volume of the mic Vivus records from (audio.input, else the system
         default source), 0 to 1 as mixers show it (cubic). Not a config key:
         WirePlumber saves it per device. Negative while unknown. -->
    <method name="GetInputGain">
      <arg name="gain" type="d" direction="out"/>
    </method>
    <!-- Sets it on the device (the card's route, like a mixer does), so it persists. -->
    <method name="SetInputGain">
      <arg name="gain" type="d" direction="in"/>
    </method>
    <!-- When it changes: from SetInputGain, another app or mixer, or a different input. -->
    <signal name="InputGainChanged">
      <arg name="gain" type="d"/>
    </signal>
  </interface>
</node>
