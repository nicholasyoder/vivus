<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<!--
  Service: org.vivus (session bus), object: /org/vivus
  Shared by vivus-daemon (server), vivusctl, vivus-sidebar and the Forest bridge.
  Keep crates/dbus/src/lib.rs in sync with this file.
-->
<node>
  <interface name="org.vivus.Assistant">
    <!-- idle | listening | thinking | speaking. Changes via org.freedesktop.DBus.Properties.PropertiesChanged. -->
    <property name="State" type="s" access="read"/>

    <method name="ToggleListen"/>
    <!-- Push-to-talk. -->
    <method name="StartListening"/>
    <method name="StopListening"/>
    <!-- Text input, bypassing STT. -->
    <method name="Ask">
      <arg name="text" type="s" direction="in"/>
    </method>
    <!-- Interrupt: cancels in-flight TTS, LLM streams and tool calls. -->
    <method name="Cancel"/>
    <!-- Shuts the daemon down. The sidebar calls this before closing itself. -->
    <method name="Quit"/>

    <!-- role: user | assistant. Partial (is_final=false) user text updates live
         while speaking; each utterance ends with one is_final=true. -->
    <signal name="Transcript">
      <arg name="role" type="s"/>
      <arg name="text" type="s"/>
      <arg name="is_final" type="b"/>
    </signal>

    <!-- Asks UIs to show, hide or toggle the sidebar. -->
    <method name="ToggleSidebar"/>
    <signal name="SidebarVisibilityRequested">
      <!-- show | hide | toggle -->
      <arg name="action" type="s"/>
    </signal>
  </interface>

  <interface name="org.vivus.Documents">
    <!-- Ids, oldest first. -->
    <method name="List">
      <arg name="ids" type="as" direction="out"/>
    </method>
    <method name="Get">
      <arg name="id" type="s" direction="in"/>
      <arg name="title" type="s" direction="out"/>
      <arg name="markdown" type="s" direction="out"/>
    </method>
    <!-- Emitted on create and on every append/replace. -->
    <signal name="DocumentChanged">
      <arg name="id" type="s"/>
      <arg name="title" type="s"/>
      <arg name="markdown" type="s"/>
    </signal>
  </interface>

  <!-- Edits ~/.config/vivus/config.toml; the daemon validates, writes and applies.
       Paths are dotted keys, e.g. audio.input, roles.stt.model. -->
  <interface name="org.vivus.Settings">
    <!-- The effective config as JSON, defaults filled in (unset options are null). -->
    <method name="Get">
      <arg name="json" type="s" direction="out"/>
    </method>
    <!-- Sets one key. An invalid path or value fails with the reason and
         leaves the file alone. -->
    <method name="Set">
      <arg name="path" type="s" direction="in"/>
      <arg name="value" type="v" direction="in"/>
    </method>
    <!-- Removes a key from the file, so its default applies. -->
    <method name="Reset">
      <arg name="path" type="s" direction="in"/>
    </method>
    <!-- After a write or a reload of a hand edit: the leaf paths whose effective value changed. -->
    <signal name="Changed">
      <arg name="paths" type="as"/>
    </signal>
  </interface>
</node>
